{
  "name": "goodgood-store",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.mts",
    "db:seed": "node --env-file-if-exists=.env.local --import tsx scripts/seed.mts",
    "db:seed-blog": "node --env-file-if-exists=.env.local --import tsx scripts/seed-blog.mts",
    "db:seed-testimonials": "node --env-file-if-exists=.env.local --import tsx scripts/seed-testimonials.mts",
    "db:seed-team": "node --env-file-if-exists=.env.local --import tsx scripts/seed-team.mts",
    "db:seed-admin": "node --env-file-if-exists=.env.local --import tsx scripts/seed-admin.mts",
    "db:studio": "node --env-file-if-exists=.env.local ./node_modules/drizzle-kit/bin.cjs studio"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.45.4",
    "framer-motion": "^14.6.0",
    "gsap": "^3.15.0",
    "lucide-react": "1.48.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "4.1.11"
  }
}
